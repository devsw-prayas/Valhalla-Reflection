// Per addendum v1.1 §A.1: primitives are declared once here, not annotated
// with VALHALLA_TYPE. Consumed two ways - X-macro-expanded by the C++ side
// (ValhallaPrimitiveTypes.h) and regex-scanned as PLAIN TEXT by Gen's C# side
// (not yet implemented). Keep this file exactly this simple: one
// VALHALLA_PRIMITIVE(name) invocation per line, no conditionals, no comments
// on the same line as an invocation, no macro nesting - the C# side does not
// parse C++, it pattern-matches this file's literal text.
#ifndef VALHALLA_PRIMITIVE
#define VALHALLA_PRIMITIVE(name)
#endif

VALHALLA_PRIMITIVE(bool)
VALHALLA_PRIMITIVE(char)
VALHALLA_PRIMITIVE(int8_t)
VALHALLA_PRIMITIVE(int16_t)
VALHALLA_PRIMITIVE(int32_t)
VALHALLA_PRIMITIVE(int64_t)
VALHALLA_PRIMITIVE(uint8_t)
VALHALLA_PRIMITIVE(uint16_t)
VALHALLA_PRIMITIVE(uint32_t)
VALHALLA_PRIMITIVE(uint64_t)
VALHALLA_PRIMITIVE(float)
VALHALLA_PRIMITIVE(double)

#undef VALHALLA_PRIMITIVE
